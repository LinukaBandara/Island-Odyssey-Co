# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real IDs or keys.

# Full production URL, used for sitemap.xml, canonical tags, and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.tamarindroutes.com

# Google Analytics 4 measurement ID. Leave blank to disable analytics
# entirely — the Analytics component won't load any script without it.
NEXT_PUBLIC_GA_ID=
