# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real IDs or keys.

# Full production URL, used for sitemap, canonical tags, and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.islandodysseyco.com

# Google Analytics 4 measurement ID. Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=

# Optional newsletter form endpoint (for example, a Formspree endpoint).
# Leave blank until a real provider is connected.
NEXT_PUBLIC_NEWSLETTER_FORM_URL=

# Public contact details. Leave blank until real business details are available.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_LOCATION=

# Optional social profile URLs. Leave blank to hide a social button.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
